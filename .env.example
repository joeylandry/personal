# ---------------------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemap, robots, JSON-LD and OG images.
# No trailing slash. Falls back to the Vercel deployment URL, then localhost.
NEXT_PUBLIC_SITE_URL=https://joeylandry.com

# Optional. When set, the contact section shows a direct email button.
# When empty, the site falls back to LinkedIn + GitHub only (no dead controls).
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Contact form delivery (optional — pick ONE provider, or none)
# ---------------------------------------------------------------------------
# With no provider configured, /api/contact returns a 503 "not configured"
# response and the form UI degrades to the LinkedIn / email fallback instead of
# pretending a message was delivered.

# Option A — Resend (https://resend.com). Both values are required together.
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "site@joeylandry.com"
CONTACT_FROM_EMAIL=
# Inbox that should receive the messages.
CONTACT_TO_EMAIL=

# Option B — Formspree (https://formspree.io). Server-side endpoint URL,
# e.g. https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=
